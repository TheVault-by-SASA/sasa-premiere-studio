{
  "manifestVersion": 5,
  "id": "sasa-premiere-studio-dev",
  "name": "SASA Premiere Studio",
  "version": "0.3.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": [
        "ws://localhost:32145/",
        "ws://localhost/"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "studio-panel",
      "label": {
        "default": "SASA Premiere Studio"
      },
      "minimumSize": {
        "width": 300,
        "height": 480
      },
      "preferredDockedSize": {
        "width": 370,
        "height": 800
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 800
      }
    }
  ]
}