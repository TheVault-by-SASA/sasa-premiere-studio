{
  "name": "sasa-premiere-studio",
  "version": "0.3.0-alpha.1",
  "private": true,
  "description": "Portable Premiere UXP panel, local engine and agent-independent MCP bridge",
  "type": "module",
  "main": "apps/desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "engine": "node services/local-engine/main.js",
    "mcp": "node services/mcp-server/main.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "stage-panel": "node scripts/stage-panel.js",
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/doctor.js",
    "release": "node scripts/package-release.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "playwright": "1.63.0"
  }
}
